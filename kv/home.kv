<HomeScreen>

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: "#0D0D0D"

        MDTopAppBar:
            type: "small"
            headline_text: "ESP32 Controller"
            md_bg_color: "#0D0D0D"
            specific_text_color: "#D4AF37"

        MDBoxLayout:
            orientation: "vertical"
            spacing: "20dp"
            padding: "25dp"

            # Connection Status Card
            MDCard:
                style: "filled"
                md_bg_color: "#161616"
                radius: [20]
                padding: "20dp"
                size_hint_y: None
                height: "230dp"
                orientation: "vertical"
                spacing: "15dp"

                # Status Icon
                MDIcon:
                    icon: root.status_icon
                    theme_icon_color: "Custom"
                    icon_color: "#2ecc71" if root.connected else ("#f39c12" if root.scanning else "#e74c3c")
                    halign: "center"
                    font_size: "64sp"

                # Connection State Label
                MDLabel:
                    text: root.connection_status
                    halign: "center"
                    font_style: "Headline"
                    role: "small"
                    theme_text_color: "Custom"
                    text_color: "#FFFFFF" if root.connected else "#888888"

                # Action Button (Swaps between Scan / Disconnect / Scanning state)
                MDButton:
                    style: "filled"
                    pos_hint: {"center_x": .5}
                    md_bg_color: "#e74c3c" if root.connected else "#D4AF37"
                    disabled: root.scanning
                    on_release:
                        root.disconnect() if root.connected else root.scan()

                    MDButtonText:
                        text: "Disconnect" if root.connected else ("Scanning..." if root.scanning else "Scan for Devices")
                        theme_text_color: "Custom"
                        text_color: "#FFFFFF" if root.connected else "#000000"

            # Scanned Devices Section (Scrollable Container)
            # Scanned Devices Section (Scrollable Container)
            MDScrollView:
                do_scroll_x: False
                do_scroll_y: True

                MDList:
                    id: robot_container
                    spacing: "10dp"
                    size_hint_y: None
                    height: self.minimum_height

            # Flexible spacer pushing contents upward
