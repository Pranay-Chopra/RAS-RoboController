<HUDControlsScreen>:
    MDNavigationLayout:
		ScreenManager:
	        MDScreen:
	            # Root FloatLayout to stack HUD Canvas below Top Bar
	            MDFloatLayout:
	                md_bg_color: 0.05, 0.05, 0.05, 1

	                # 1. Canvas Layer (Bottom Layer)
	                MDFloatLayout:
	                    id: hud_canvas
	                    size_hint: 1, 1
	                    pos_hint: {"x": 0, "y": 0}

	                # 2. Top Action Bar (Top Layer - Always visible!)
	                MDBoxLayout:
	                    orientation: "horizontal"
	                    size_hint: 1, None
	                    height: "56dp"
	                    pos_hint: {"top": 1}
	                    padding: ["12dp", "4dp"]
	                    spacing: "8dp"
	                    md_bg_color: 0.08, 0.08, 0.08, 0.95

	                    # Hamburger Menu
	                    MDIconButton:
	                        icon: "menu"
	                        theme_text_color: "Custom"
	                        text_color: 0.83, 0.68, 0.21, 1
	                        on_release: nav_drawer.set_state("toggle")



	                    Widget:
	                        size_hint_x: .5

						MDLabel:
	                        text: "Controls"
	                        font_style: "H6"
	                        bold: True
	                        halign: "center"
	                        theme_text_color: "Custom"
	                        text_color: 0.83, 0.68, 0.21, 1

						Widget:
	                        size_hint_x: .5

	                    # EDIT / PLAY Toggle Mode Button
	                    MDRaisedButton:
	                        text: "PLAY" if root.is_edit_mode else "EDIT"
	                        md_bg_color: (0.83, 0.68, 0.21, 1) if not root.is_edit_mode else (0.8, 0.2, 0.2, 1)
	                        text_color: (0, 0, 0, 1) if not root.is_edit_mode else (1, 1, 1, 1)
	                        on_release: root.toggle_edit_mode()
							pos_hint: {"center_y": 0.5}


	                    # Add Element Dropdown
	                    MDIconButton:
	                        icon: "plus-box"
	                        theme_text_color: "Custom"
	                        text_color: 0.83, 0.68, 0.21, 1
	                        disabled: not root.is_edit_mode
	                        on_release: root.open_add_widget_menu(self)

	                    # Save Layout
	                    # MDIconButton:
	                        # icon: "content-save"
	                        # theme_text_color: "Custom"
	                        # text_color: 0.83, 0.68, 0.21, 1
	                        # disabled: not root.is_edit_mode
	                        # on_release: root.save_layout()




        # 2. Second Required Child: MDNavigationDrawer
        MDNavigationDrawer:
            id: nav_drawer
            radius: (0, 16, 16, 0)
            md_bg_color: 0.08, 0.08, 0.08, 1

            MDBoxLayout:
                orientation: 'vertical'
                padding: [0, dp(16), 0, 0]
                spacing: dp(8)

                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(60)
                    padding: [dp(16), dp(8)]

                    MDLabel:
                        text: "Navigation"
                        font_style: "H6"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: 0.83, 0.68, 0.21, 1

                    MDSeparator:
                        height: dp(1)
                        color: 0.2, 0.2, 0.2, 1

                ScrollView:
                    MDList:
                        OneLineIconListItem:
                            text: "Home"
                            text_color: 1, 1, 1, 1
                            theme_text_color: "Custom"
                            on_release: nav_drawer.set_state("close"); root.switch_screen("home")
                            IconLeftWidget:
                                icon: "home"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                on_release: nav_drawer.set_state("close"); root.switch_screen("home")

                        OneLineIconListItem:
                            text: "Controls"
                            text_color: 0.83, 0.68, 0.21, 1
                            theme_text_color: "Custom"
                            on_release: nav_drawer.set_state("close"); root.switch_screen("controls")
                            IconLeftWidget:
                                icon: "gamepad-variant"
                                theme_text_color: "Custom"
                                text_color: 0.83, 0.68, 0.21, 1
                                on_release: nav_drawer.set_state("close"); root.switch_screen("controls")



                        OneLineIconListItem:
                            text: "Serial Monitor"
                            text_color: 1, 1, 1, 1
                            theme_text_color: "Custom"
                            on_release: nav_drawer.set_state("close"); root.switch_screen("serial")
                            IconLeftWidget:
                                icon: "console-line"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                on_release: nav_drawer.set_state("close"); root.switch_screen("serial")

                        OneLineIconListItem:
                            text: "Announcements"
                            text_color: 1, 1, 1, 1
                            theme_text_color: "Custom"
                            on_release: nav_drawer.set_state("close"); root.switch_screen("announcements")
                            IconLeftWidget:
                                icon: "bullhorn"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                on_release: nav_drawer.set_state("close"); root.switch_screen("announcements")

                        OneLineIconListItem:
                            text: "Quiz"
                            text_color: 1, 1, 1, 1
                            theme_text_color: "Custom"
                            on_release: nav_drawer.set_state("close"); root.switch_screen("quiz")
                            IconLeftWidget:
                                icon: "clipboard-list-outline"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                on_release: nav_drawer.set_state("close"); root.switch_screen("quiz")

                        OneLineIconListItem:
                            text: "Help"
                            text_color: 1, 1, 1, 1
                            theme_text_color: "Custom"
                            on_release: nav_drawer.set_state("close"); root.switch_screen("help")
                            IconLeftWidget:
                                icon: "help-circle"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                on_release: nav_drawer.set_state("close"); root.switch_screen("help")

                        OneLineIconListItem:
                            text: "About"
                            text_color: 1, 1, 1, 1
                            theme_text_color: "Custom"
                            on_release: nav_drawer.set_state("close"); root.switch_screen("about")
                            IconLeftWidget:
                                icon: "information"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                on_release: nav_drawer.set_state("close"); root.switch_screen("about")


                        MDSeparator:
                            height: dp(1)
                            color: 0.2, 0.2, 0.2, 1

                        Widget:
                        	size_hint_y: 1

                        OneLineIconListItem:
                            text: "Export Layout"
                            text_color: 1, 1, 1, 1
                            theme_text_color: "Custom"
                            on_release: nav_drawer.set_state("close"); root.export_layout()
                            IconLeftWidget:
                                icon: "export"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                on_release: nav_drawer.set_state("close"); root.export_layout()

                        OneLineIconListItem:
                            text: "Import Layout"
                            text_color: 1, 1, 1, 1
                            theme_text_color: "Custom"
                            on_release: nav_drawer.set_state("close"); root.import_layout()
                            IconLeftWidget:
                                icon: "import"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                on_release: nav_drawer.set_state("close"); root.import_layout()
