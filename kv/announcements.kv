#:kivy 2.0

<AnnouncementsScreen>:
    MDNavigationLayout:

        ScreenManager:
            MDScreen:
                MDBoxLayout:
                    orientation: 'vertical'

                    MDFloatLayout:
                        id: top_bar
                        size_hint_y: None
                        height: dp(56)
                        md_bg_color: 0.08, 0.08, 0.08, 1

                        MDIconButton:
                            icon: "menu"
                            theme_text_color: "Custom"
                            text_color: 0.83, 0.68, 0.21, 1
                            pos_hint: {"center_y": 0.5}
                            x: dp(8)
                            on_release: root.open_nav_drawer()

                        MDLabel:
                            text: "Announcements"
                            font_style: "H6"
                            bold: True
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: 0.83, 0.68, 0.21, 1
                            size_hint: 1, None
                            size: self.texture_size
                            pos_hint: {"center_x": 0.5, "center_y": 0.5}

                    FloatLayout:
                        id: webview_container
                        size_hint: 1, 1

        MDNavigationDrawer:
            id: nav_drawer
            radius: (0, 16, 16, 0)
            md_bg_color: 0.08, 0.08, 0.08, 1

            MDBoxLayout:
                orientation: 'vertical'
                padding: [0, dp(16), 0, 0]
                spacing: dp(8)

                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(60)
                    padding: [dp(16), dp(8)]

                    MDLabel:
                        text: "Navigation"
                        font_style: "H6"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: 0.83, 0.68, 0.21, 1

                    MDSeparator:
                        height: dp(1)
                        color: 0.2, 0.2, 0.2, 1

                ScrollView:
                    MDList:
                        OneLineIconListItem:
                            text: "Home"
                            text_color: 1, 1, 1, 1
                            theme_text_color: "Custom"
                            on_release: nav_drawer.set_state("close"); root.switch_screen("home")
                            IconLeftWidget:
                                icon: "home"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                on_release: nav_drawer.set_state("close"); root.switch_screen("home")

                        OneLineIconListItem:
                            text: "Controls"
                            text_color: 1, 1, 1, 1
                            theme_text_color: "Custom"
                            on_release: nav_drawer.set_state("close"); root.switch_screen("controls")
                            IconLeftWidget:
                                icon: "gamepad-variant"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                on_release: nav_drawer.set_state("close"); root.switch_screen("controls")

                        OneLineIconListItem:
                            text: "Serial Monitor"
                            text_color: 1, 1, 1, 1
                            theme_text_color: "Custom"
                            on_release: nav_drawer.set_state("close"); root.switch_screen("serial")
                            IconLeftWidget:
                                icon: "console-line"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                on_release: nav_drawer.set_state("close"); root.switch_screen("serial")

                        OneLineIconListItem:
                            text: "Announcements"
                            text_color: 0.83, 0.68, 0.21, 1
                            theme_text_color: "Custom"
                            on_release: nav_drawer.set_state("close"); root.switch_screen("announcements")
                            IconLeftWidget:
                                icon: "bullhorn"
                                theme_text_color: "Custom"
                                text_color: 0.83, 0.68, 0.21, 1
                                on_release: nav_drawer.set_state("close"); root.switch_screen("announcements")

                        OneLineIconListItem:
                            text: "Quiz"
                            text_color: 1, 1, 1, 1
                            theme_text_color: "Custom"
                            on_release: nav_drawer.set_state("close"); root.switch_screen("quiz")
                            IconLeftWidget:
                                icon: "clipboard-list-outline"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                on_release: nav_drawer.set_state("close"); root.switch_screen("quiz")

                        OneLineIconListItem:
                            text: "Help"
                            text_color: 1, 1, 1, 1
                            theme_text_color: "Custom"
                            on_release: nav_drawer.set_state("close"); root.switch_screen("help")
                            IconLeftWidget:
                                icon: "help-circle"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                on_release: nav_drawer.set_state("close"); root.switch_screen("help")

                        OneLineIconListItem:
                            text: "About"
                            text_color: 1, 1, 1, 1
                            theme_text_color: "Custom"
                            on_release: nav_drawer.set_state("close"); root.switch_screen("about")
                            IconLeftWidget:
                                icon: "information"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                on_release: nav_drawer.set_state("close"); root.switch_screen("about")
